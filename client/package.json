{
  "name": "@cometgo/client",
  "version": "0.1.0",
  "description": "TypeScript client for CometGo",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmichov/CometGo.git",
    "directory": "client"
  },
  "homepage": "https://github.com/tmichov/CometGo#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "default": "./dist/react-native.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/react-native.js",
    "./src/react-native.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node build-dts.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.79",
    "@react-native-community/netinfo": ">=11",
    "react-native-get-random-values": ">=1.11"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    },
    "react-native-get-random-values": {
      "optional": true
    }
  }
}
