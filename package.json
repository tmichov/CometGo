{
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "build": "npm run build:client && esbuild app=examples/todo/web/src/main.ts react=examples/todo/web/src/react-main.tsx --bundle --format=esm --target=es2022 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outdir=examples/todo/web/public",
    "build:client": "npm run build -w @cometgo/client",
    "typecheck": "npm run build:client && tsc -p client",
    "test": "node --test \"client/test/*.test.ts\""
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0"
  }
}
